# Port the service listens on. Most hosts (Render, Railway, Fly.io) inject
# this automatically — you usually don't need to set it yourself.
PORT=5174

# Comma-separated list of frontend origins allowed to call this service.
# Set this to your deployed QFormat URL(s) in production. Leave unset to
# allow all origins (fine for local dev only).
ALLOWED_ORIGINS=https://your-qformat-domain.com

# Set automatically by the Dockerfile — points Puppeteer at the
# apt-get-installed Chromium instead of trying to download its own.
# You normally don't need to set this yourself unless running outside Docker.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
